# Copiez ce fichier en ".env" et changez ABSOLUMENT les valeurs avant de déployer.

# Port d'écoute du serveur
PORT=3000

# Secret utilisé pour signer les jetons de connexion (JWT).
# Générez une valeur aléatoire forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# Identifiants du tout premier compte propriétaire, créés automatiquement
# au premier démarrage si la base est vide. Changez le mot de passe
# immédiatement après votre première connexion, depuis Paramètres.
INITIAL_OWNER_USERNAME=proprietaire
INITIAL_OWNER_PASSWORD=ChangezMoi2026!
INITIAL_OWNER_NAME=Propriétaire

# Nom / emplacement par défaut de la boutique
SHOP_NAME=Empire 229 · Panam
SHOP_LOCATION=Boutique Ganhi

# À renseigner UNIQUEMENT si le frontend est hébergé sur un domaine séparé
# du backend (ex. frontend sur Vercel, API sur Railway). Mettre l'URL
# exacte du frontend, ex. : https://empire229-panam.vercel.app
# Laisser vide si frontend et backend sont servis ensemble (recommandé).
ALLOWED_ORIGIN=
